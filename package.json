{
  "name": "nhatranggo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node --env-file=.env scripts/database.mjs migrate",
    "db:seed": "node --env-file=.env scripts/database.mjs seed",
    "db:content": "node --env-file=.env scripts/seed-content.mjs",
    "admin:setup": "node --env-file=.env scripts/setup-admin.mjs",
    "test": "node --env-file=.env tests/e2e/verify.mjs",
    "test:cms": "node --env-file=.env tests/e2e/verify-cms.mjs",
    "format": "prettier --write src scripts tests docs *.json *.ts *.mjs *.cjs *.yml",
    "test:modules": "node --env-file=.env tests/e2e/modules.mjs",
    "test:home": "node --env-file=.env tests/e2e/home.mjs",
    "test:navigation": "node --env-file=.env tests/e2e/navigation.mjs",
    "prestart": "node --env-file-if-exists=.env scripts/check-env.mjs",
    "test:production": "node --env-file=.env tests/e2e/production.mjs",
    "fonts:refresh": "node scripts/maintenance/fonts.mjs",
    "test:deployment": "node tests/unit/deployment.mjs",
    "test:theme": "node --test tests/unit/theme.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "write-excel-file": "^4.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "22.x"
  }
}
